{
  "name": "shiny",
  "version": "0.1.13",
  "main": "packages/main/dist/index.js",
  "description": "An extensible SPARQL client built with Electron and Vue 3",
  "private": true,
  "author": "Ben Gould",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "node scripts/build.js",
    "test": "npm run test:main && npm run test:preload && npm run test:renderer",
    "test:run": "npm run test",
    "test:ui": "vitest --ui",
    "test:e2e": "npm run build -w @shiny/main && npm run build -w @shiny/preload && playwright test -c e2e/playwright.config.ts",
    "test:coverage": "npm run test:coverage:main && npm run test:coverage:renderer && npm run test:coverage:preload",
    "test:main": "cd packages/main && npx vitest run",
    "test:renderer": "cd packages/renderer && npx vitest run",
    "test:preload": "cd packages/preload && npx vitest run",
    "test:coverage:main": "cd packages/main && npx vitest run --coverage",
    "test:coverage:renderer": "cd packages/renderer && npx vitest run --coverage",
    "test:coverage:preload": "cd packages/preload && npx vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,vue,js,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,vue,js,json,css,md}\"",
    "type-check": "npm run type-check:main && npm run type-check:preload && npm run type-check:renderer && npm run type-check:e2e",
    "type-check:main": "tsc --noEmit -p packages/main/tsconfig.json",
    "type-check:preload": "tsc --noEmit -p packages/preload/tsconfig.json",
    "type-check:renderer": "cd packages/renderer && npx vue-tsc --noEmit",
    "type-check:e2e": "tsc --noEmit -p e2e/tsconfig.json",
    "clean": "rimraf dist packages/*/dist",
    "bump-version": "node scripts/bump-version.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.0",
    "@vitest/coverage-v8": "^5.0.2",
    "@vitest/ui": "^5.0.2",
    "concurrently": "^8.2.2",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.12.0",
    "prettier": "^3.7.4",
    "rimraf": "^5.0.5",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2",
    "vue-eslint-parser": "^10.4.1",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "aws4": "^1.12.0",
    "axios": "^1.6.7",
    "axios-cookiejar-support": "^6.0.5",
    "electron-store": "^8.2.0",
    "sparqljs": "^3.7.3",
    "tough-cookie": "^6.0.0"
  },
  "build": {
    "appId": "gould.one.shiny",
    "productName": "Shiny",
    "directories": {
      "output": "dist"
    },
    "files": [
      "packages/main/dist/**",
      "packages/preload/dist/**",
      "packages/renderer/dist/**",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "icons/shiny.icns",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "entitlements": null,
      "entitlementsInherit": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "icons/shiny.ico",
      "artifactName": "${productName} Setup ${version}-${arch}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icons/shiny.ico"
    }
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  }
}
